+        frame(c, mod, pf, poses, fa, blocks_mod, L, end, a, b, hook, endtxt, self.gap)
+        self.first = frame_px(c).copy()
+
+    def px(self, c, f):
+        from lessongen import loop_k, loop_blend
+        return loop_blend(frame_px(c), self.first, loop_k(f - self.fa, self.n))
